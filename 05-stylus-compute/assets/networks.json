{
  "_comment": "Network + Stylus tooling config for stylus-compute. Default atlantic-testnet.",
  "atlantic-testnet": {
    "name": "Pharos Atlantic Testnet",
    "chainId": 688689,
    "caip2": "eip155:688689",
    "rpcUrl": "https://atlantic.dplabs-internal.com",
    "explorer": "https://atlantic.pharosscan.xyz",
    "nativeToken": "PHRS",
    "default": true,
    "stylus": {
      "sdk": "pharos-stylus-sdk-rs",
      "cli": "pharos-cargo-stylus",
      "starter": "stylus-hello-world",
      "deployedContracts": { "verifier": "", "classifier": "" }
    }
  },
  "gasPolicy": { "rule": "Set gas limit 10-20% above estimate; Pharos charges by gas_limit." }
}
