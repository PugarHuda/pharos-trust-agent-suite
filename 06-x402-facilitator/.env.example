# Copy to .env (gitignored) and fill in. NEVER commit real keys.
# Payer key: signs payment authorizations (sign only — never sends a tx, spends no gas).
PAYER_PRIVATE_KEY=0x...
# Facilitator key: the gas payer that relays settled payments on-chain.
FACILITATOR_PRIVATE_KEY=0x...
# Optional RPC override (defaults to assets/networks.json).
# RPC_URL=https://atlantic.dplabs-internal.com
