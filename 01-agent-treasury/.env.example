# Copy to .env (gitignored) and fill in. NEVER commit real keys.
# Owner key: deploys the treasury and sets policy (the human's key).
OWNER_PRIVATE_KEY=0x...
# Session key: the agent's bounded key; can only spend within policy.
SESSION_PRIVATE_KEY=0x...
# Optional RPC override (defaults to the network in assets/networks.json).
# RPC_URL=https://atlantic.dplabs-internal.com
