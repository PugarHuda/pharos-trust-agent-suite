# Copy to .env (gitignored) and fill in. NEVER commit real keys.
# Recorder key: deploys contracts and records settled x402 payments (the mesh relayer).
RECORDER_PRIVATE_KEY=0x...
# Payer/provider key: registers services and rates interactions the payer paid for.
PAYER_PRIVATE_KEY=0x...
# Optional RPC override (defaults to assets/networks.json).
# RPC_URL=https://atlantic.dplabs-internal.com
